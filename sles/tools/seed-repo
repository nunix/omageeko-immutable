#!/bin/bash
# Seed the local RPM repo (/var/lib/omageeko/repo) from a machine that already built it,
# so build_lock skips every package whose stamp still matches (saves ~50 min of builds).
# Usage: sles/tools/seed-repo <user@source>              run on the target
#        sles/tools/seed-repo <user@source> <user@target>  relay from a third machine
#                                                         (when the target can't ssh to the source)
# Per-machine stamps don't travel: *-installed and 03-userland/03-ghostty-deployed describe the
# source's install state, builder-image makes the target build its own image (needed
# anyway for payload extraction).
set -euo pipefail
src=${1:?usage: seed-repo <user@source> [<user@target>]}
dst=${2:-}
receive='set -euo pipefail
d=/var/lib/omageeko
sudo mkdir -p "$d"
sudo chown "$(id -un):" "$d"
[[ -e $d/repo ]] && mv "$d/repo" "$d/repo.before-seed.$(date +%s)"
tar -C "$d" -xf -
rm -f "$d"/repo/.stamps/*-installed "$d"/repo/.stamps/03-userland "$d"/repo/.stamps/03-ghostty-deployed "$d"/repo/.stamps/builder-image
echo "seeded: $(find "$d/repo" -name "*.rpm" | wc -l) RPMs, $(ls "$d/repo/.stamps" | wc -l) build stamps, $(du -sh "$d/repo" | cut -f1)"'
if [[ -n $dst ]]; then
  ssh -o BatchMode=yes "$src" 'tar -C /var/lib/omageeko -cf - repo' | ssh -o BatchMode=yes "$dst" "bash -c '$receive'"
else
  ssh -o BatchMode=yes "$src" 'tar -C /var/lib/omageeko -cf - repo' | bash -c "$receive"
fi
