#!/bin/bash
# Publish a finished machine's local RPM repo as a GitHub release of omageeko-immutable,
# so new installs seed from it (install.sh --seed github, the default) instead of building
# for ~50 min or needing another machine.
# Usage: sles/tools/publish-repo <user@source|local> [--replace]
#   Run on a machine with this checkout and an authenticated gh. The source must have
#   built (or seeded) the repo from the same locks as this checkout. `local` publishes this
#   machine's own repo (no ssh).
# Release tag: repo-<repo_key> (lib/common.sh): one release per set of locks.
set -euo pipefail
src=${1:?usage: publish-repo <user@source|local> [--replace]}
replace=${2:-}
OMAGEEKO_IMM=$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)
# common.sh refuses nothing on source; it only needs the paths and repo_key
source "$OMAGEEKO_IMM/sles/lib/common.sh"
command -v gh >/dev/null || die "gh is required"
# run a command on the source: here for `local`, else over ssh
on_src() { if [[ $src == local ]]; then bash -c "$1"; else ssh -o BatchMode=yes "$src" "$1"; fi; }

key=$(repo_key)
tag="repo-$key"
# The source checkout must be at the same locks, or its RPMs belong to another key
src_key=$(on_src 'cd ~/omageeko-immutable && bash -c "source sles/lib/common.sh; repo_key"') ||
  die "Cannot compute repo_key on $src (is ~/omageeko-immutable there?)"
[[ $src_key == "$key" ]] || die "$src has locks for repo-$src_key, this checkout is repo-$key: sync it first (sles/tools/sync-guest)"

if gh release view "$tag" -R "$OMAGEEKO_GH_REPO" >/dev/null 2>&1; then
  [[ $replace == --replace ]] || die "Release $tag exists (use --replace to overwrite its assets)"
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
excludes=()
for s in "${OMAGEEKO_LOCAL_STAMPS[@]}"; do excludes+=(--exclude="repo/.stamps/$s"); done
log "Fetching /var/lib/omageeko/repo from $src"
on_src "tar -C /var/lib/omageeko ${excludes[*]} -cf - repo" > "$tmp/$OMAGEEKO_REPO_ASSET"
rpms=$(tar -tf "$tmp/$OMAGEEKO_REPO_ASSET" | grep -c '\.rpm$')
stamps=$(tar -tf "$tmp/$OMAGEEKO_REPO_ASSET" | grep -c '^repo/\.stamps/.')
(( rpms > 0 )) || die "No RPMs in $src's repo"
(cd "$tmp" && sha256sum "$OMAGEEKO_REPO_ASSET" > SHA256SUMS)
size=$(du -h "$tmp/$OMAGEEKO_REPO_ASSET" | cut -f1)
commit=$(git -C "$OMAGEEKO_IMM" rev-parse --short HEAD 2>/dev/null || echo '?')
notes="Prebuilt RPMs for omageeko on SLES 16.1 Immutable (local repo /var/lib/omageeko/repo).

- $rpms RPMs, $stamps build stamps, $size
- Locks: omageeko-immutable $commit, Omarchy $(omarchy_release), BUILD_REV $BUILD_REV
- Used by \`sles/install.sh --seed github\` (default). Build stamps decide what still builds locally.
- Integrity: SHA256SUMS. The RPMs are not signed (the local repo has gpgcheck off)."

if gh release view "$tag" -R "$OMAGEEKO_GH_REPO" >/dev/null 2>&1; then
  log "Replacing assets of $tag"
  gh release upload "$tag" -R "$OMAGEEKO_GH_REPO" --clobber "$tmp/$OMAGEEKO_REPO_ASSET" "$tmp/SHA256SUMS"
  gh release edit "$tag" -R "$OMAGEEKO_GH_REPO" --notes "$notes"
else
  log "Creating release $tag ($rpms RPMs, $size)"
  gh release create "$tag" -R "$OMAGEEKO_GH_REPO" --title "Prebuilt repo $tag" --notes "$notes" \
    --latest=false "$tmp/$OMAGEEKO_REPO_ASSET" "$tmp/SHA256SUMS"
fi
log "Published https://github.com/$OMAGEEKO_GH_REPO/releases/tag/$tag"
